{
    "realm": "remote-control",
    "displayName": "Remote Program Control",
    "enabled": true,
    "loginWithEmailAllowed": true,
    "registrationAllowed": true,
    "resetPasswordAllowed": true,
    "rememberMe": true,
    "identityProviders": [
        {
            "alias": "google",
            "displayName": "Google",
            "providerId": "google",
            "enabled": true,
            "updateProfileFirstLoginMode": "on",
            "trustEmail": true,
            "storeToken": false,
            "addReadTokenRoleOnCreate": false,
            "authenticateByDefault": false,
            "linkOnly": false,
            "firstBrokerLoginFlowAlias": "first broker login",
            "config": {
                "clientId": "308955191046-6ig3nk6bkuibbmhkjc0ttifd5unhg5sc.apps.googleusercontent.com",
                "clientSecret": "REMOVED",
                "useJwksUrl": "true",
                "jwksUrl": "https://www.googleapis.com/oauth2/v3/certs",
                "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
                "tokenUrl": "https://oauth2.googleapis.com/token",
                "defaultScope": "openid profile email",
                "uiLocales": "en"
            }
        }
    ],
    "attributes": {
        "userProfileEnabled": "true"
    },
    "components": {
        "org.keycloak.userprofile.UserProfileProvider": [
            {
                "id": "c1f72740-4c3e-436f-8dc3-339241b71120",
                "name": "declarative-user-profile",
                "providerId": "declarative-user-profile",
                "subComponents": {},
                "config": {
                    "kc.user.profile.config": [
                        "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}}]}"
                    ]
                }
            }
        ]
    },
    "identityProviderMappers": [
        {
            "name": "google-username",
            "identityProviderAlias": "google",
            "identityProviderMapper": "oidc-username-idp-mapper",
            "config": {
                "template": "${CLAIM.email}",
                "syncMode": "IMPORT"
            }
        },
        {
            "name": "google-email",
            "identityProviderAlias": "google",
            "identityProviderMapper": "oidc-user-attribute-idp-mapper",
            "config": {
                "claim": "email",
                "user.attribute": "email",
                "syncMode": "IMPORT"
            }
        },
        {
            "name": "google-first-name",
            "identityProviderAlias": "google",
            "identityProviderMapper": "oidc-user-attribute-idp-mapper",
            "config": {
                "claim": "given_name",
                "user.attribute": "firstName",
                "syncMode": "IMPORT"
            }
        },
        {
            "name": "google-last-name",
            "identityProviderAlias": "google",
            "identityProviderMapper": "oidc-user-attribute-idp-mapper",
            "config": {
                "claim": "family_name",
                "user.attribute": "lastName",
                "syncMode": "IMPORT"
            }
        }
    ],
    "roles": {
        "realm": [
            { "name": "offline_access", "description": "Offline tokens" },
            { "name": "uma_authorization", "description": "UMA resource access" }
        ],
        "client": {
            "remote-control-api": [
                {
                    "name": "USER",
                    "description": "Standard user",
                    "composite": false,
                    "clientRole": true
                },
                {
                    "name": "ADMIN",
                    "description": "Administrator",
                    "composite": false,
                    "clientRole": true
                }
            ]
        }
    },
    "clients": [
        {
            "clientId": "remote-control-api",
            "name": "Remote Control API + UI",
            "protocol": "openid-connect",
            "publicClient": true,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "frontchannelLogout": true,
            "attributes": {
                "pkce.code.challenge.method": "S256",
                "post.logout.redirect.uris": "http://localhost:8090/*"
            },
            "redirectUris": ["http://localhost:8090/login/oauth2/code/*", "http://localhost:8888/callback"],
            "webOrigins": ["http://localhost:8090", "http://localhost:8888"],
            "defaultClientScopes": ["profile", "email", "roles", "web-origins", "acr"],
            "optionalClientScopes": ["offline_access", "address", "phone"]
        }
    ]
}
