# Copy to prod.env (not committed) and fill in your values
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL connection
DB_URL="jdbc:postgresql://<host>:<port>/<db>?sslmode=require"
DB_USER="remote_program_control"
DB_PASSWORD="[SOME_PASSWORD]"
DB_SCHEMA="remote_program_control"

# JWT settings (required)
APP_JWT_SECRET="[VERY_LONG_RANDOM_STRING_MIN_32_CHARS]"
APP_JWT_ISSUER="remote-program-control"
APP_JWT_ACCESS_TTL_SECONDS=900
APP_JWT_REFRESH_TTL_SECONDS=604800

# Optional: override Hibernate strategy (prod uses update by default in this repo)
APP_HIBERNATE_DDL_AUTO=update
