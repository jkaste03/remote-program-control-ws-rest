# Copy to prod.env (not committed) and fill in your values
SPRING_PROFILES_ACTIVE=prod

# HTTP deployment behind Netlify.
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/remote-program-control

# PostgreSQL connection on the Oracle VPS.
# If PostgreSQL is on the same VPS, keep the host as 127.0.0.1 and do not
# expose PostgreSQL's port publicly.
DB_URL="jdbc:postgresql://127.0.0.1:5432/remote_program_control?sslmode=disable"
DB_USER="remote_program_control"
DB_PASSWORD="[GENERATED_DATABASE_PASSWORD]"
# Use "public" for the default schema, or create this dedicated schema first.
DB_SCHEMA="public"

# JWT settings (required)
APP_JWT_SECRET="[VERY_LONG_RANDOM_STRING_MIN_32_CHARS]"
APP_JWT_ISSUER="remote-program-control"
APP_JWT_ACCESS_TTL_SECONDS=900
APP_JWT_REFRESH_TTL_SECONDS=604800

# Production should validate an already prepared schema. Use "update" only
# during an explicit migration/bootstrap step.
APP_HIBERNATE_DDL_AUTO=validate

# The production profile deliberately does not run ConfigCommandLineRunner.
# Create roles/users and migrate/import existing data before starting the app.
